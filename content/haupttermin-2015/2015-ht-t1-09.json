      "answer": {
        "kind": "open",
        "rubric": [
          {
            "t": "text",
            "v": "Alle angegebenen Eigenschaften der Polynomfunktion müssen in der Skizze erkennbar sein. Eine Polynomfunktion "
          },
          {
            "t": "math",
            "v": "f"
          },
          {
            "t": "text",
            "v": " hat folgende Eigenschaften:\n\n• Die Funktion ist für "
          },
          {
            "t": "math",
            "v": "x\\le0"
          },
          {
            "t": "text",
            "v": " streng monoton steigend.\n• Die Funktion ist im Intervall "
          },
          {
            "t": "math",
            "v": "[0;3]"
          },
          {
            "t": "text",
            "v": " streng monoton fallend.\n• Die Funktion ist für "
          },
          {
            "t": "math",
            "v": "x\\ge3"
          },
          {
            "t": "text",
            "v": " streng monoton steigend.\n• Der Punkt "
          },
          {
            "t": "math",
            "v": "P=(0|1)"
          },
          {
            "t": "text",
            "v": " ist ein lokales Maximum (Hochpunkt).\n• Die Stelle 3 ist eine Nullstelle."
          },
          {
            "t": "text",
            "v": "\n\nBewertung: Ein Punkt für eine korrekte Skizze, wobei alle in der Angabe angeführten Eigenschaften der Polynomfunktion f erkennbar sein müssen."
          }
        ],
