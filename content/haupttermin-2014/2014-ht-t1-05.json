      "solution": [
        {
          "result": [
            {
              "t": "text",
              "v": "Parallele Geraden haben die gleiche Steigung bzw. parallele Richtungsvektoren. "
            },
            {
              "t": "math",
              "v": "k_g=-\\frac14"
            },
            {
              "t": "text",
              "v": ". Der Richtungsvektor "
            },
            {
              "t": "math",
              "v": "\\vec a_h=\\binom{4}{-1}"
            },
            {
              "t": "text",
              "v": " ist parallel zu "
            },
            {
              "t": "math",
              "v": "\\binom{1}{-\\frac14}"
            },
            {
              "t": "text",
              "v": "; daraus folgt "
            },
            {
              "t": "math",
              "v": "k_h=k_g"
            },
            {
              "t": "text",
              "v": ".\n\nOder: "
            },
            {
              "t": "math",
              "v": "g:X=\\binom47+t\\binom4{-1},\\ t\\in\\mathbb R"
            },
            {
              "t": "text",
              "v": ". Somit ist "
            },
            {
              "t": "math",
              "v": "\\vec a_g=\\vec a_h"
            },
            {
              "t": "text",
              "v": ".\n\nAuch eine Begründung mit Normalvektoren ist möglich: "
            },
            {
              "t": "math",
              "v": "g:x+4y=32"
            },
            {
              "t": "text",
              "v": ", "
            },
            {
              "t": "math",
              "v": "h:x+4y=16"
            },
            {
              "t": "text",
              "v": ". Somit ist "
            },
            {
              "t": "math",
              "v": "\\vec n_g\\parallel\\vec n_h"
            },
            {
              "t": "text",
              "v": ", oder "
            },
            {
              "t": "math",
              "v": "\\vec n_g\\cdot\\vec a_h=0"
            },
            {
              "t": "text",
              "v": "."
            }
          ],
          "note": "Ein Punkt wird vergeben, wenn eine Begründung vorhanden und mathematisch korrekt ist."
        }
      ],
