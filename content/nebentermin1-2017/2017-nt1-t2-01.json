            {
              "t": "math",
              "v": "\\dfrac12=\\dfrac{N(\\tau)}{N_0}=\\dfrac{N_0\\cdot0{,}5^{\\frac{\\tau}{c}}}{N_0}=0{,}5^{\\frac{\\tau}{c}}\\iff\\dfrac{\\tau}{c}=1\\iff\\tau=c"
