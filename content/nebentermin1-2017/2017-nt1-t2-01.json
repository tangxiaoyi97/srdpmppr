        {
          "t": "text",
          "v": " aus der gemessenen Aktivität "
        },
        {
          "t": "math",
          "v": "A_0"
        },
        {
          "t": "text",
          "v": " berechnet werden kann!"
        }
      ],
      "figures": [],
      "answer": {
        "kind": "expression",
        "canonical": "A_0/lambda",
        "vars": [
          "A_0",
          "lambda"
        ],
        "checker": "cas"
      },
      "scoring": {
        "mode": "allOrNothing",
        "points": 1
      },
      "points": 1,
      "solution": [
        {
          "result": [
            {
              "t": "text",
              "v": "Mögliche Vorgehensweise: "
            },
            {
              "t": "math",
              "v": "A(t)=|N'(t)|=\\lambda\\cdot N_0\\cdot e^{-\\lambda\\cdot t}"
            },
            {
              "t": "text",
              "v": ", "
            },
            {
              "t": "math",
              "v": "A_0=\\lambda\\cdot N_0"
            },
            {
              "t": "text",
              "v": ", also "
            },
            {
              "t": "math",
              "v": "N_0=\\dfrac{A_0}{\\lambda}"
            },
            {
              "t": "text",
              "v": "."
            }
          ],
          "note": "Ein Punkt für eine korrekte Formel. Äquivalente Formeln sind als richtig zu werten."
        }
      ]
    },
    {
      "id": "2017-nt1-t2-01-a2",
      "label": "a2",
      "format": "Halboffenes Antwortformat",
      "competencies": [],
      "externalRefs": [
        {
          "system": "maturaArchiv",
