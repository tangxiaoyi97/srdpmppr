          "verifiedAt": "2026-09-13"
        }
      ],
      "prompt": [
        {
          "t": "text",
          "v": "Eine Probe von "
        },
        {
          "t": "math",
          "v": "^{238}\\mathrm{U}"
        },
        {
          "t": "text",
          "v": " (Uran-238) hat zum Zeitpunkt "
        },
        {
          "t": "math",
          "v": "t=0"
        },
        {
          "t": "text",
          "v": " eine Aktivität von 17 Bq. Die Zerfallskonstante von "
        },
        {
          "t": "math",
          "v": "^{238}\\mathrm{U}"
        },
        {
          "t": "text",
          "v": " hat den Wert "
        },
        {
          "t": "math",
          "v": "\\lambda\\approx4{,}92\\cdot10^{-18}"
        },
        {
          "t": "text",
          "v": " pro Sekunde.\nBestimmen Sie die Anzahl der "
        },
        {
          "t": "math",
          "v": "^{238}\\mathrm{U}"
        },
        {
          "t": "text",
          "v": "-Atomkerne zum Zeitpunkt "
        },
        {
          "t": "math",
          "v": "t=0"
        },
        {
          "t": "text",
          "v": " in der Probe!"
        }
      ],
      "figures": [],
      "answer": {
        "kind": "open",
        "rubric": [
          {
            "t": "math",
            "v": "N_0\\approx3{,}46\\cdot10^{18}"
          },
          {
            "t": "text",
            "v": " Atomkerne; jede Zahl im Toleranzintervall "
          },
          {
            "t": "math",
            "v": "[3{,}4\\cdot10^{18};3{,}5\\cdot10^{18}]"
          },
          {
            "t": "text",
            "v": " ist richtig."
          }
        ],
        "grader": "ai"
      },
      "scoring": {
        "mode": "allOrNothing",
        "points": 1
      },
      "points": 1,
      "solution": [
        {
          "result": [
            {
              "t": "math",
              "v": "N_0=\\dfrac{A_0}{\\lambda}=\\dfrac{17}{4{,}92\\cdot10^{-18}}\\approx3{,}46\\cdot10^{18}"
            },
            {
              "t": "text",
              "v": ". Zum Zeitpunkt "
            },
            {
              "t": "math",
              "v": "t=0"
            },
            {
              "t": "text",
              "v": " befinden sich ca. "
            },
            {
              "t": "math",
              "v": "3{,}46\\cdot10^{18}"
            },
            {
              "t": "text",
              "v": " Atomkerne von "
            },
            {
              "t": "math",
              "v": "^{238}\\mathrm{U}"
            },
            {
              "t": "text",
              "v": " in der Probe."
            }
          ],
          "note": "Ein Punkt für die richtige Lösung. Toleranzintervall: [3,4 · 10^18 Atomkerne; 3,5 · 10^18 Atomkerne]."
        }
      ]
    },
    {
      "id": "2017-nt1-t2-01-b1",
      "label": "b1",
      "format": "Offenes Antwortformat",
      "competencies": [],
      "externalRefs": [
        {
          "system": "maturaArchiv",
