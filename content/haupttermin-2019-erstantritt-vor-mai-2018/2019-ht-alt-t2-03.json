            "t": "math",
            "v": "X"
          },
          {
            "t": "text",
            "v": " als binomialverteilt angenähert werden.\n"
          },
          {
            "t": "math",
            "v": "n=30"
          },
          {
            "t": "text",
            "v": "\n"
          },
          {
            "t": "math",
            "v": "p=\\frac{2\\,144}{40\\,777}\\approx0{,}0526"
          },
          {
            "t": "text",
            "v": "\n"
          },
          {
            "t": "math",
            "v": "P(X\\ge1)=1-P(X=0)=1-\\left(1-\\frac{2\\,144}{40\\,777}\\right)^{30}\\approx0{,}80217"
