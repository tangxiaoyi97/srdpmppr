      "t": "text",
      "v": ", während die hintere Seitenfläche "
    },
    {
      "t": "math",
      "v": "DCGH"
    },
    {
      "t": "text",
      "v": " zur Grundfläche unter dem Winkel "
    },
    {
      "t": "math",
      "v": "\\alpha"
    },
